@page
@model Intelligently.Admin.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<form method="post" id="login-form">
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <label>User name <input asp-for="Input.UserName" autocomplete="username" required /></label>
    <label>Password <input asp-for="Input.Password" autocomplete="current-password" required /></label>
    <label><input asp-for="Input.RememberMe" /> Remember me</label>
    <button type="submit">Sign in</button>
    @if (Model.Error is not null)
    {
        <p class="text-danger">@Model.Error</p>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</form>
