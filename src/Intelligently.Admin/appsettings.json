{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agents": {
    "DefaultModel": "claude-opus-5-5",
    "CheapModel": "claude-haiku-5-5",
    "Budgets": {
      "ReplansLeft": 3,
      "RetriesLeft": 2,
      "ToolCallsLeft": 40,
      "TokensLeft": 300000,
      "WallClockMinutes": 30,
      "PromptTokens": 150000,
      "StagePromptTokens": {}
    },
    "Context": {
      "KnowledgeEntries": 8,
      "Episodes": 5,
      "EpisodeCandidates": 200,
      "CompactAfterTokens": 100000,
      "SummaryMaxChars": 2000,
      "SummaryInputMaxChars": 24000
    },
    "Mcp": {
      "Servers": [],
      "RiskOverrides": {},
      "NameSeparator": "__",
      "ConnectTimeoutSeconds": 30,
      "CallTimeoutSeconds": 120
    },
    "Sandbox": {
      "Image": "mcr.microsoft.com/dotnet/sdk:10.0",
      "PullImage": true,
      "TimeoutSeconds": 60,
      "MemoryBytes": 536870912,
      "Cpus": 1.0,
      "PidsLimit": 256,
      "MaxOutputBytes": 65536,
      "WorkingDirectory": "/work",
      "Wasm": {
        "Fuel": 2000000000,
        "MemoryBytes": 67108864,
        "TimeoutSeconds": 10,
        "MaxOutputBytes": 65536
      }
    },
    "QueueCapacity": 100,
    "MaxToolResultChars": 16000,
    "ApprovalSweepSeconds": 15,
    "StageLeaseSeconds": 600,
    "Policy": {
      "Rules": [
        {
          "Name": "enrolment",
          "Kind": "Identity",
          "RequireCourseScope": true
        },
        {
          "Name": "read-only",
          "Kind": "Risk",
          "RiskLevels": [
            "ReadOnly"
          ],
          "Effect": "Allow"
        },
        {
          "Name": "mutating-in-scope",
          "Kind": "Risk",
          "RiskLevels": [
            "Mutating"
          ],
          "Effect": "AllowInScope"
        },
        {
          "Name": "destructive-approval",
          "Kind": "Risk",
          "RiskLevels": [
            "Destructive"
          ],
          "Effect": "RequireApproval"
        },
        {
          "Name": "external-approval",
          "Kind": "Risk",
          "RiskLevels": [
            "External"
          ],
          "Effect": "RequireApproval"
        },
        {
          "Name": "per-run",
          "Kind": "RateLimit",
          "Scope": "Run",
          "PermitLimit": 20,
          "WindowSeconds": 60
        },
        {
          "Name": "per-user",
          "Kind": "RateLimit",
          "Scope": "User",
          "PermitLimit": 60,
          "WindowSeconds": 60
        },
        {
          "Name": "idempotent-mutations",
          "Kind": "Idempotency",
          "RiskLevels": [
            "Mutating",
            "Destructive",
            "External"
          ]
        }
      ]
    }
  }
}
